<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>MomentumPorter.Cli</RootNamespace>
    <!-- Keep the executable's name, scripts such as pack_for_momentum.bat call MomentumPorter.exe -->
    <AssemblyName>MomentumPorter</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MomentumPorter.Core\MomentumPorter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The bundled bspPack, next to the app where BspPackTool looks first -->
    <None Include="$(RepoRoot)tools\bspPack\**" Exclude="$(RepoRoot)tools\bspPack\README.md" LinkBase="bspPack" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>

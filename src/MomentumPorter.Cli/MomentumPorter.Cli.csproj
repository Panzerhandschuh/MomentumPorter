<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>MomentumPorter.Cli</RootNamespace>
    <!-- The -CLI suffix tells it from MomentumPorter-UI.exe next to it in a release (scripts such as
         pack_for_momentum.bat that called MomentumPorter.exe need updating) -->
    <AssemblyName>MomentumPorter-CLI</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MomentumPorter.Core\MomentumPorter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The bundled bspPack, next to the app where BspPackTool looks first. Kept out of single-file releases, which
         would otherwise bundle bspPack.exe as a native library and extract it to a temp folder. -->
    <None Include="$(RepoRoot)tools\bspPack\**" Exclude="$(RepoRoot)tools\bspPack\README.md" LinkBase="bspPack" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" Visible="false" />
  </ItemGroup>

</Project>

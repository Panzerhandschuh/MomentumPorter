<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MomentumPorter.UI.ViewModels.Pages"
             xmlns:shared="using:MomentumPorter.UI.ViewModels.Shared"
             xmlns:views="using:MomentumPorter.UI.Views.Shared"
             xmlns:conv="using:MomentumPorter.UI.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="MomentumPorter.UI.Views.Pages.MapsPageView"
             x:DataType="vm:MapsPageViewModel"
             Name="Page">

  <Grid RowDefinitions="Auto, *, 6, 260" ColumnDefinitions="*, 12, 340" Margin="16 14 16 12">

    <!-- Header and actions -->
    <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0 0 0 12">
      <StackPanel DockPanel.Dock="Left" Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="Maps" Classes="h1" />
        <TextBlock Text="Port Source maps (KZ Mod), pack their assets and install them into Momentum Mod"
                   Classes="muted" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Command="{Binding AddFilesCommand}" ToolTip.Tip="Add .bsp, .pk3 or .zip maps to the queue (or drop them on the window)">
          <StackPanel>
            <materialIcons:MaterialIcon Kind="Plus" />
            <TextBlock Text="Add maps" />
          </StackPanel>
        </Button>
        <Button Command="{Binding RunCommand}" Classes="accent" ToolTip.Tip="Port every queued map, one at a time">
          <StackPanel>
            <materialIcons:MaterialIcon Kind="Play" />
            <TextBlock Text="Run" />
          </StackPanel>
        </Button>
        <Button Command="{Binding CancelCommand}" ToolTip.Tip="Stop the running map; nothing is installed for it">
          <StackPanel>
            <materialIcons:MaterialIcon Kind="Stop" />
            <TextBlock Text="Cancel" />
          </StackPanel>
        </Button>
      </StackPanel>
    </DockPanel>

    <!-- Queue -->
    <Border Grid.Row="1" Grid.Column="0" Classes="panel">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="12 8 6 4">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
            <Button Classes="icon" Command="{Binding RequeueAllCommand}" ToolTip.Tip="Queue every finished map again">
              <materialIcons:MaterialIcon Kind="Restart" />
            </Button>
            <Button Classes="icon" Command="{Binding ClearFinishedCommand}" ToolTip.Tip="Remove done and skipped maps from the list">
              <materialIcons:MaterialIcon Kind="NotificationClearAll" />
            </Button>
          </StackPanel>
          <TextBlock Text="Queue" Classes="h2" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Classes="muted" Margin="12 4 12 8"
                   TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Panel>
          <StackPanel IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
            <materialIcons:MaterialIcon Kind="TrayArrowDown" Width="40" Height="40" Opacity="0.5" />
            <TextBlock Text="Drop maps here, or use Add maps" Classes="muted" HorizontalAlignment="Center" />
          </StackPanel>
          <ListBox ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedItem}" Background="Transparent"
                   IsVisible="{Binding !IsEmpty}">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="10 8" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Margin" Value="4 1" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:MapQueueItemViewModel">
                <Grid ColumnDefinitions="Auto, *, Auto">
                  <materialIcons:MaterialIcon Grid.Column="0" Width="20" Height="20" VerticalAlignment="Top"
                                              Margin="0 1 10 0"
                                              Kind="{Binding Status, Converter={x:Static conv:QueueStatusConverters.Icon}}"
                                              Foreground="{Binding Status, Converter={x:Static conv:QueueStatusConverters.Brush}}"
                                              ToolTip.Tip="{Binding Status}" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding InputPath}" />
                    <TextBlock Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding KindText}" />
                      <Run Text=" · " />
                      <Run Text="{Binding Game, TargetNullValue='unknown game'}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Note}" Classes="warning" FontSize="12" TextWrapping="Wrap"
                               IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <StackPanel IsVisible="{Binding IsRunning}" Spacing="2" Margin="0 4 0 0">
                      <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" MinWidth="0" Height="4" />
                      <TextBlock Text="{Binding StepText}" FontSize="12" Classes="muted" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{Binding Status, Converter={x:Static conv:QueueStatusConverters.Brush}}"
                               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Spacing="2">
                    <Button Classes="icon" ToolTip.Tip="Queue again" IsVisible="{Binding IsFinished}"
                            Command="{Binding #Page.((vm:MapsPageViewModel)DataContext).RequeueCommand}"
                            CommandParameter="{Binding}">
                      <materialIcons:MaterialIcon Kind="Restart" Width="16" Height="16" />
                    </Button>
                    <Button Classes="icon" ToolTip.Tip="Remove from the queue" IsEnabled="{Binding !IsRunning}"
                            Command="{Binding #Page.((vm:MapsPageViewModel)DataContext).RemoveCommand}"
                            CommandParameter="{Binding}">
                      <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" />
                    </Button>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Panel>
      </DockPanel>
    </Border>

    <!-- Options -->
    <Border Grid.Row="1" Grid.Column="2" Classes="panel">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="12 8 6 4">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
            <Button Classes="icon" Command="{Binding LoadPresetCommand}" ToolTip.Tip="Load options from a preset file">
              <materialIcons:MaterialIcon Kind="FolderOpenOutline" />
            </Button>
            <Button Classes="icon" Command="{Binding SavePresetCommand}" ToolTip.Tip="Save these options as a preset file">
              <materialIcons:MaterialIcon Kind="ContentSaveOutline" />
            </Button>
          </StackPanel>
          <TextBlock Text="Options" Classes="h2" VerticalAlignment="Center" />
        </DockPanel>
        <ScrollViewer Padding="12 4 12 4">
          <StackPanel Spacing="8">
            <Expander Header="Source maps (KZ Mod, GOKZ)" IsExpanded="True" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Maps made for other Source games: their entities are converted with a game profile, then bspPack packs the assets">
              <views:OptionsForm Form="{Binding OptionsForm}" />
            </Expander>
            <Expander Header="Quake 3 and GoldSrc maps (BSPConvert)" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Quake 3 (.bsp/.pk3) and Half-Life/CS 1.6 (.bsp/.zip) maps are converted with BSPConvert; these are its options. Install, Overwrite and Compress above apply too.">
              <views:OptionsForm Form="{Binding BspConvertOptionsForm}" />
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <GridSplitter Grid.Row="2" Grid.ColumnSpan="3" ResizeDirection="Rows" Background="Transparent" />

    <!-- Log and report of the selected map -->
    <Border Grid.Row="3" Grid.ColumnSpan="3" Classes="panel">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="6 4 6 0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Command="{Binding OpenOutputFolderCommand}" ToolTip.Tip="Where maps that aren't installed are saved (set in Settings)">
              <StackPanel>
                <materialIcons:MaterialIcon Kind="FolderOutline" />
                <TextBlock Text="Open output folder" />
              </StackPanel>
            </Button>
            <Button Command="{Binding OpenMomentumMapsCommand}" ToolTip.Tip="Momentum Mod's maps folder">
              <StackPanel>
                <materialIcons:MaterialIcon Kind="FolderPlayOutline" />
                <TextBlock Text="Open in Momentum maps folder" />
              </StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Text="{Binding SelectedItem.Title, FallbackValue='', TargetNullValue=''}" Classes="muted"
                     VerticalAlignment="Center" Margin="8 0" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <TabControl Padding="0" Margin="4 0 4 4">
          <TabItem Header="Log" FontSize="14">
            <views:LogView DataContext="{Binding SelectedItem.Log, FallbackValue={x:Null}}" />
          </TabItem>
          <TabItem Header="Report" FontSize="14">
            <ScrollViewer Background="#33000000">
              <StackPanel Margin="10 6">
                <TextBlock Text="Nothing to report yet. The report lists what was converted and anything that couldn't be."
                           Classes="muted" TextWrapping="Wrap"
                           IsVisible="{Binding !SelectedItem.HasReport, FallbackValue=True}" />
                <ItemsControl ItemsSource="{Binding SelectedItem.Report, FallbackValue={x:Null}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="shared:ReportLine">
                      <SelectableTextBlock Text="{Binding Text}" FontFamily="{StaticResource Monospace}" FontSize="12"
                                           Classes.warning="{Binding IsWarning}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </DockPanel>
    </Border>
  </Grid>

</UserControl>

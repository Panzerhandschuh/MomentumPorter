<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MomentumPorter.UI.ViewModels.Pages"
             xmlns:shared="using:MomentumPorter.UI.ViewModels.Shared"
             xmlns:views="using:MomentumPorter.UI.Views.Shared"
             xmlns:conv="using:MomentumPorter.UI.Converters"
             xmlns:review="using:MomentumPorter.Review"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="MomentumPorter.UI.Views.Pages.MapsPageView"
             x:DataType="vm:MapsPageViewModel"
             Name="Page">

  <Grid RowDefinitions="Auto, *, 6, 260" ColumnDefinitions="*, 12, 340" Margin="16 14 16 12">

    <!-- Header and actions -->
    <!-- The buttons dock first so they keep their width; the description takes what's left and trims -->
    <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0 0 0 12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12 0 0 0">
        <Button Command="{Binding AddFilesCommand}" ToolTip.Tip="Add .bsp, .pk3 or .zip maps to the queue (or drop them on the window)">
          <StackPanel>
            <materialIcons:MaterialIcon Kind="Plus" />
            <TextBlock Text="Add maps" />
          </StackPanel>
        </Button>
        <Button Command="{Binding RunCommand}" Classes="accent" ToolTip.Tip="Port every queued map, one at a time, into Momentum's maps folder">
          <StackPanel>
            <materialIcons:MaterialIcon Kind="Play" />
            <TextBlock Text="Run" />
          </StackPanel>
        </Button>
        <Button Command="{Binding CancelCommand}" ToolTip.Tip="Stop the running map; nothing is installed for it">
          <StackPanel>
            <materialIcons:MaterialIcon Kind="Stop" />
            <TextBlock Text="Cancel" />
          </StackPanel>
        </Button>
      </StackPanel>
      <StackPanel Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="Maps" Classes="h1" />
        <TextBlock Text="Port KZ Mod, GOKZ, CS:S, Quake 3 and GoldSrc maps, pack their assets and install them into Momentum Mod"
                   Classes="muted" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DockPanel>

    <!-- Queue -->
    <Border Grid.Row="1" Grid.Column="0" Classes="panel">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="12 8 6 4">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
            <Button Classes="icon" Command="{Binding RequeueAllCommand}" ToolTip.Tip="Queue every finished map again">
              <materialIcons:MaterialIcon Kind="Restart" />
            </Button>
            <Button Classes="icon" Command="{Binding ClearFinishedCommand}" ToolTip.Tip="Remove done and skipped maps from the list">
              <materialIcons:MaterialIcon Kind="NotificationClearAll" />
            </Button>
          </StackPanel>
          <TextBlock Text="Queue" Classes="h2" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Classes="muted" Margin="12 4 12 8"
                   TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Panel>
          <StackPanel IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
            <materialIcons:MaterialIcon Kind="TrayArrowDown" Width="40" Height="40" Opacity="0.5" />
            <TextBlock Text="Drop maps here, or use Add maps" Classes="muted" HorizontalAlignment="Center" />
          </StackPanel>
          <ListBox ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedItem}" Background="Transparent"
                   IsVisible="{Binding !IsEmpty}">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="10 8" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Margin" Value="4 1" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:MapQueueItemViewModel">
                <Grid ColumnDefinitions="Auto, *, Auto">
                  <materialIcons:MaterialIcon Grid.Column="0" Width="20" Height="20" VerticalAlignment="Top"
                                              Margin="0 1 10 0"
                                              Kind="{Binding Status, Converter={x:Static conv:QueueStatusConverters.Icon}}"
                                              Foreground="{Binding Status, Converter={x:Static conv:QueueStatusConverters.Brush}}"
                                              ToolTip.Tip="{Binding Status}" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding InputPath}" />
                    <TextBlock Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding KindText}" />
                      <Run Text=" · " />
                      <Run Text="{Binding Game, TargetNullValue='unknown game'}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Note}" Classes="warning" FontSize="12" TextWrapping="Wrap"
                               IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <StackPanel IsVisible="{Binding IsRunning}" Spacing="2" Margin="0 4 0 0">
                      <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" MinWidth="0" Height="4" />
                      <TextBlock Text="{Binding StepText}" FontSize="12" Classes="muted" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{Binding Status, Converter={x:Static conv:QueueStatusConverters.Brush}}"
                               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <!-- Entities the in-game entity tools still have to change; the Next steps tab says how -->
                    <Grid ColumnDefinitions="Auto, *" Margin="0 2 0 0"
                          IsVisible="{Binding Attention, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                          ToolTip.Tip="Something to do by hand before the map can be submitted. See the Next steps tab below.">
                      <materialIcons:MaterialIcon Grid.Column="0" Kind="AlertOutline" Width="14" Height="14" VerticalAlignment="Top"
                                                  Margin="0 1 4 0" Foreground="{StaticResource WarningBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding Attention}" Classes="warning" FontSize="12" TextWrapping="Wrap" />
                    </Grid>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Spacing="2">
                    <Button Classes="icon" IsVisible="{Binding CanReview}" IsEnabled="{Binding !IsRunning}"
                            ToolTip.Tip="Check the map against Momentum's entity tools as it is, without porting it: for a ported map saved from Lumper after the in-game review, to see whether anything was left out"
                            Command="{Binding #Page.((vm:MapsPageViewModel)DataContext).ReviewCommand}"
                            CommandParameter="{Binding}">
                      <materialIcons:MaterialIcon Kind="ClipboardCheckOutline" Width="16" Height="16" />
                    </Button>
                    <Button Classes="icon" ToolTip.Tip="Queue again" IsVisible="{Binding IsFinished}"
                            Command="{Binding #Page.((vm:MapsPageViewModel)DataContext).RequeueCommand}"
                            CommandParameter="{Binding}">
                      <materialIcons:MaterialIcon Kind="Restart" Width="16" Height="16" />
                    </Button>
                    <Button Classes="icon" ToolTip.Tip="Remove from the queue" IsEnabled="{Binding !IsRunning}"
                            Command="{Binding #Page.((vm:MapsPageViewModel)DataContext).RemoveCommand}"
                            CommandParameter="{Binding}">
                      <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" />
                    </Button>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Panel>
      </DockPanel>
    </Border>

    <!-- Options: one flat list, the map options then BSPConvert's, with the advanced ones behind one toggle -->
    <Border Grid.Row="1" Grid.Column="2" Classes="panel">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="12 8 6 4">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
            <ToggleButton IsChecked="{Binding ShowAdvanced}" Padding="8 5" ToolTip.Tip="Show the advanced options too">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <materialIcons:MaterialIcon Kind="Tune" Width="16" Height="16" />
                <TextBlock Text="Advanced" FontSize="13" />
              </StackPanel>
            </ToggleButton>
            <Button Classes="icon" Command="{Binding LoadPresetCommand}" ToolTip.Tip="Load options from a preset file">
              <materialIcons:MaterialIcon Kind="FolderOpenOutline" />
            </Button>
            <Button Classes="icon" Command="{Binding SavePresetCommand}" ToolTip.Tip="Save these options as a preset file">
              <materialIcons:MaterialIcon Kind="ContentSaveOutline" />
            </Button>
          </StackPanel>
          <TextBlock Text="Options" Classes="h2" VerticalAlignment="Center" />
        </DockPanel>
        <ScrollViewer Padding="12 4 12 4">
          <!-- Only the options for the kinds of map in the queue are shown (all of them while it's empty) -->
          <StackPanel>
            <views:OptionsForm Form="{Binding OptionsForm}" />
            <views:OptionsForm Form="{Binding BspConvertOptionsForm}" IsVisible="{Binding ShowBspConvertOptions}"
                               ToolTip.Tip="Quake 3 (.bsp/.pk3) and Half-Life/CS 1.6 (.bsp/.zip) maps are converted with BSPConvert; these are its options. Compress output applies to them too." />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <GridSplitter Grid.Row="2" Grid.ColumnSpan="3" ResizeDirection="Rows" Background="Transparent" />

    <!-- Log and report of the selected map -->
    <Border Grid.Row="3" Grid.ColumnSpan="3" Classes="panel">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="6 4 6 0">
          <Button DockPanel.Dock="Right" Command="{Binding OpenMomentumMapsCommand}" ToolTip.Tip="Show the installed map, or Momentum Mod's maps folder">
            <StackPanel>
              <materialIcons:MaterialIcon Kind="FolderPlayOutline" />
              <TextBlock Text="Open Momentum maps folder" />
            </StackPanel>
          </Button>
          <TextBlock Text="{Binding SelectedItem.Title, FallbackValue='', TargetNullValue=''}" Classes="muted"
                     VerticalAlignment="Center" Margin="8 0" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <TabControl Padding="0" Margin="4 0 4 4" SelectedIndex="{Binding BottomTab}">
          <TabItem Header="Log" FontSize="14">
            <views:LogView DataContext="{Binding SelectedItem.Log, FallbackValue={x:Null}}" />
          </TabItem>
          <TabItem Header="Report" FontSize="14">
            <ScrollViewer Background="#33000000">
              <StackPanel Margin="10 6">
                <TextBlock Text="Nothing to report yet. The report lists what was converted and anything that couldn't be."
                           Classes="muted" TextWrapping="Wrap"
                           IsVisible="{Binding !SelectedItem.HasReport, FallbackValue=True}" />
                <ItemsControl ItemsSource="{Binding SelectedItem.Report, FallbackValue={x:Null}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="shared:ReportLine">
                      <SelectableTextBlock Text="{Binding Text}" FontFamily="{StaticResource Monospace}" FontSize="12"
                                           Classes.warning="{Binding IsWarning}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <!-- What's left to do by hand to get the map onto Momentum Mod's website, each step linked to its docs section -->
          <TabItem FontSize="14">
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Next steps" />
                <!-- Dot while the selected map's steps haven't been looked at -->
                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{StaticResource WarningBrush}"
                         IsVisible="{Binding NextStepsUnread}" ToolTip.Tip="New next steps" />
              </StackPanel>
            </TabItem.Header>
            <ScrollViewer Background="#33000000">
              <StackPanel Margin="10 6" Spacing="2">
                <TextBlock Text="Once a map is ported, the steps to get it onto Momentum Mod's website are listed here: the entities to change with the in-game entity tools, the Lumper checks, zoning, screenshots and the submission form, each linked to the docs."
                           Classes="muted" TextWrapping="Wrap"
                           IsVisible="{Binding !SelectedItem.HasNextSteps, FallbackValue=True}" />
                <ItemsControl ItemsSource="{Binding SelectedItem.NextSteps, FallbackValue={x:Null}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="review:NextStep">
                      <StackPanel Margin="0 0 0 10" Spacing="1">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                        <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" />
                        <HyperlinkButton NavigateUri="{Binding Uri}" Content="{Binding Url}" FontSize="12" Padding="0 2"
                                         IsVisible="{Binding Url, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </DockPanel>
    </Border>
  </Grid>

</UserControl>

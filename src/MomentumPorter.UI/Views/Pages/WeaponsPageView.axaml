<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MomentumPorter.UI.ViewModels.Pages"
             xmlns:shared="using:MomentumPorter.UI.ViewModels.Shared"
             xmlns:views="using:MomentumPorter.UI.Views.Shared"
             xmlns:conv="using:MomentumPorter.UI.Converters"
             xmlns:weapons="using:MomentumPorter.Assets.Weapons"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="MomentumPorter.UI.Views.Pages.WeaponsPageView"
             x:DataType="vm:WeaponsPageViewModel"
             Name="Page">

  <UserControl.Styles>
    <Style Selector="ListBox.choices ListBoxItem">
      <Setter Property="Padding" Value="10 6" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Margin" Value="4 1" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto, *, 6, 240" Margin="16 14 16 12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="*" MinWidth="260" />
    </Grid.ColumnDefinitions>

    <!-- Header and actions -->
    <!-- The buttons dock first so they keep their width; the description takes what's left and trims -->
    <DockPanel Grid.Row="0" Grid.ColumnSpan="5" Margin="0 0 0 12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12 0 0 0">
        <Button Command="{Binding BuildCommand}" Classes="accent" ToolTip.Tip="Build the pack into Momentum's custom folder">
          <StackPanel>
            <materialIcons:MaterialIcon Kind="Play" />
            <TextBlock Text="Build pack" />
          </StackPanel>
        </Button>
        <Button Command="{Binding BuildAllCommand}" ToolTip.Tip="{Binding BuildAllTip}">
          <StackPanel>
            <materialIcons:MaterialIcon Kind="PlaylistPlay" />
            <TextBlock Text="Build all weapons" />
          </StackPanel>
        </Button>
        <Button Command="{Binding CancelCommand}" ToolTip.Tip="Stop the running build">
          <StackPanel>
            <materialIcons:MaterialIcon Kind="Stop" />
            <TextBlock Text="Cancel" />
          </StackPanel>
        </Button>
      </StackPanel>
      <StackPanel Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="Weapons" Classes="h1" />
        <TextBlock Text="Replace a game mode's Momentum weapon with one from another game, with a pack in momentum/custom"
                   Classes="muted" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DockPanel>

    <!-- 1 and 2: the game mode and the Momentum weapon to replace -->
    <Border Grid.Row="1" Grid.Column="0" Classes="panel">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="12 8 12 6" Spacing="4">
          <TextBlock Text="Game mode" Classes="h2" />
          <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" HorizontalAlignment="Stretch"
                    ToolTip.Tip="The pack's weapon is only used in this mode (scripts/&lt;mode&gt;/, which needs the engine change in docs/engine-changes.md); other modes keep what they have">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="weapons:GameModeGroup">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="Momentum weapon" Classes="h2" Margin="0 8 0 0" />
        </StackPanel>
        <ListBox Classes="choices" ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}" Background="Transparent" Margin="4 0 4 4">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:MomentumWeaponViewModel">
              <StackPanel Spacing="1">
                <TextBlock Text="{Binding Name}" />
                <!-- What the pack installed in it; the package icon marks it as the pack's, not Momentum's own -->
                <Grid ColumnDefinitions="Auto, *" IsVisible="{Binding InPack, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                      ToolTip.Tip="Installed by the pack in momentum/custom">
                  <materialIcons:MaterialIcon Kind="PackageVariantClosed" Width="12" Height="12" Margin="0 1 4 0"
                                              VerticalAlignment="Top" Foreground="{StaticResource SuccessBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding InPack}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                </Grid>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- 3 and 4: the game and the weapon that goes in its place -->
    <Border Grid.Row="1" Grid.Column="2" Classes="panel">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="12 8 12 6" Spacing="4">
          <TextBlock Text="Game" Classes="h2" />
          <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="weapons:CatalogGame">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <!-- A paragraph per game, clipped to two lines so the weapon list keeps its room; the arrow shows the rest -->
          <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding GameLimitations, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding GameLimitations}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                       MaxLines="{Binding GameNotesMaxLines}" TextTrimming="CharacterEllipsis" />
            <ToggleButton Grid.Column="1" IsChecked="{Binding GameNotesExpanded}" VerticalAlignment="Top" Margin="4 0 0 0"
                          Padding="2" Background="Transparent" BorderThickness="0" ToolTip.Tip="Show the rest">
              <Panel>
                <materialIcons:MaterialIcon Kind="ChevronDown" Width="14" Height="14" IsVisible="{Binding !GameNotesExpanded}" />
                <materialIcons:MaterialIcon Kind="ChevronUp" Width="14" Height="14" IsVisible="{Binding GameNotesExpanded}" />
              </Panel>
            </ToggleButton>
          </Grid>
          <TextBlock Text="Weapon" Classes="h2" Margin="0 8 0 0" />
        </StackPanel>
        <Panel>
          <TextBlock Text="{Binding NoWeaponsMessage}" IsVisible="{Binding !Weapons.Count}" Classes="muted" TextWrapping="Wrap"
                     TextAlignment="Center" VerticalAlignment="Center" Margin="16" />
          <ListBox Classes="choices" ItemsSource="{Binding Weapons}" SelectedItem="{Binding SelectedWeapon}" Background="Transparent" Margin="4 0 4 4"
                   IsVisible="{Binding !!Weapons.Count}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="weapons:CatalogWeapon">
                <StackPanel Spacing="1">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Text="{Binding View}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Panel>
      </DockPanel>
    </Border>

    <!-- Builds -->
    <Border Grid.Row="1" Grid.Column="4" Classes="panel">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Builds" Classes="h2" Margin="12 8 12 4" />
        <Panel>
          <StackPanel IsVisible="{Binding !Builds.Count}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="360">
            <materialIcons:MaterialIcon Kind="Pistol" Width="40" Height="40" Opacity="0.5" />
            <TextBlock Text="Pick a game mode and the Momentum weapon to replace, then the game and the weapon to put in its place, and Build pack. Build all weapons fills every weapon of the mode with the game's best fits. A new pack needs a Momentum restart; rebuilding one only needs exec porter_reload in game (sv_cheats 1)."
                       Classes="muted" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>
          <ListBox ItemsSource="{Binding Builds}" SelectedItem="{Binding SelectedBuild}" Background="Transparent"
                   IsVisible="{Binding !!Builds.Count}">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="10 8" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Margin" Value="4 1" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:WeaponPackBuildViewModel">
                <Grid ColumnDefinitions="Auto, *">
                  <materialIcons:MaterialIcon Grid.Column="0" Width="20" Height="20" VerticalAlignment="Top" Margin="0 1 10 0"
                                              Kind="{Binding Status, Converter={x:Static conv:QueueStatusConverters.Icon}}"
                                              Foreground="{Binding Status, Converter={x:Static conv:QueueStatusConverters.Brush}}"
                                              ToolTip.Tip="{Binding Status}" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <StackPanel IsVisible="{Binding IsRunning}" Spacing="2" Margin="0 4 0 0">
                      <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" MinWidth="0" Height="4" />
                      <TextBlock Text="{Binding StepText}" FontSize="12" Classes="muted" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{Binding Status, Converter={x:Static conv:QueueStatusConverters.Brush}}"
                               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding OutputPath}" FontSize="12" Classes="muted" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding OutputPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Panel>
      </DockPanel>
    </Border>

    <GridSplitter Grid.Row="2" Grid.ColumnSpan="5" ResizeDirection="Rows" Background="Transparent" />

    <!-- Log and report of the selected build -->
    <Border Grid.Row="3" Grid.ColumnSpan="5" Classes="panel">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="6 4 6 0">
          <Button DockPanel.Dock="Right" Command="{Binding OpenPackFolderCommand}" ToolTip.Tip="Show the pack, or Momentum's custom folder">
            <StackPanel>
              <materialIcons:MaterialIcon Kind="FolderOutline" />
              <TextBlock Text="Open pack folder" />
            </StackPanel>
          </Button>
          <TextBlock Text="{Binding SelectedBuild.Title, FallbackValue='', TargetNullValue=''}" Classes="muted"
                     VerticalAlignment="Center" Margin="8 0" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <TabControl Padding="0" Margin="4 0 4 4">
          <TabItem Header="Log" FontSize="14">
            <views:LogView DataContext="{Binding SelectedBuild.Log, FallbackValue={x:Null}}" />
          </TabItem>
          <TabItem Header="Report" FontSize="14">
            <ScrollViewer Background="#33000000">
              <StackPanel Margin="10 6">
                <TextBlock Text="Nothing to report yet. The report lists what the pack contains and what the port can't reproduce."
                           Classes="muted" TextWrapping="Wrap"
                           IsVisible="{Binding !SelectedBuild.HasReport, FallbackValue=True}" />
                <ItemsControl ItemsSource="{Binding SelectedBuild.Report, FallbackValue={x:Null}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="shared:ReportLine">
                      <SelectableTextBlock Text="{Binding Text}" FontFamily="{StaticResource Monospace}" FontSize="12"
                                           Classes.warning="{Binding IsWarning}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </DockPanel>
    </Border>
  </Grid>

</UserControl>

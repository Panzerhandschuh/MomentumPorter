<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MomentumPorter.UI.ViewModels.Pages"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="MomentumPorter.UI.Views.Pages.MapSoundsWindow"
        x:DataType="vm:MapSoundsViewModel"
        Title="{Binding Title}"
        Width="980" Height="680" MinWidth="840" MinHeight="420"
        WindowStartupLocation="CenterOwner">

  <Window.Resources>
    <!--
      The theme pads a slider 15px either side of its 20px thumb and makes it at least 32px, all on one side when the
      padding is less: the timeline would make the bar grow as it appears, and the volume slider sat off centre.
      Even 6px makes both 32px across, the buttons' height, with the thumb in the middle.
    -->
    <GridLength x:Key="SliderPreContentMargin">6</GridLength>
    <GridLength x:Key="SliderPostContentMargin">6</GridLength>
    <x:Double x:Key="SliderHorizontalHeight">0</x:Double>
    <x:Double x:Key="SliderVerticalWidth">0</x:Double>
  </Window.Resources>

  <Window.Styles>
    <!-- A sound the review takes out of the map -->
    <Style Selector="TextBlock.removed">
      <Setter Property="TextDecorations" Value="Strikethrough" />
      <Setter Property="Opacity" Value="0.55" />
    </Style>
  </Window.Styles>

  <Window.DataTemplates>
    <DataTemplate DataType="vm:MapSoundRowViewModel">
      <Border Padding="6 5" CornerRadius="4" Background="#0AFFFFFF" Margin="0 1">
        <Grid ColumnDefinitions="Auto, 64, Auto, *, Auto">
          <Button Grid.Column="0" Classes="icon" VerticalAlignment="Center" Command="{Binding PlayCommand}"
                  ToolTip.Tip="Listen to it (press again to stop)">
            <Panel>
              <materialIcons:MaterialIcon Kind="Play" Width="18" Height="18" IsVisible="{Binding !IsPlaying}" />
              <materialIcons:MaterialIcon Kind="Stop" Width="18" Height="18" IsVisible="{Binding IsPlaying}" />
            </Panel>
          </Button>
          <TextBlock Grid.Column="1" Text="{Binding Length}" VerticalAlignment="Center" HorizontalAlignment="Right"
                     Margin="0 0 12 0" FontFamily="{StaticResource Monospace}" FontSize="12" />
          <CheckBox Grid.Column="2" Content="Music" IsChecked="{Binding IsMusic}" VerticalAlignment="Center" Margin="0 0 12 0"
                    ToolTip.Tip="Move it into sound/music/ when the map is ported, so the music volume slider controls it" />
          <StackPanel Grid.Column="3" Spacing="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       Classes.removed="{Binding IsRemoved}" ToolTip.Tip="{Binding Path}" />
            <TextBlock Text="{Binding Uses}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding UsesTip}" />
          </StackPanel>
          <ToggleButton Grid.Column="4" IsChecked="{Binding IsRemoved}" Padding="6 4" VerticalAlignment="Center" Margin="8 0 0 0"
                        ToolTip.Tip="Take it out of the map when it's ported, e.g. copyrighted music">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" />
              <TextBlock Text="Remove" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.DataTemplates>

  <DockPanel Margin="16 14 16 12">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0 0 0 8">
      <TextBlock Classes="h1">
        <Run Text="Sounds" />
        <Run Text="{Binding MapName}" Foreground="{StaticResource MutedBrush}" FontWeight="Normal" />
      </TextBlock>
      <TextBlock Text="{Binding Intro}" Classes="muted" TextWrapping="Wrap" />
      <TextBlock Text="{Binding PortedNote}" Classes="warning" TextWrapping="Wrap"
                 IsVisible="{Binding PortedNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>

    <!-- Above the list, which the volume slider opens over -->
    <DockPanel Name="PreviewBar" DockPanel.Dock="Bottom" Margin="0 10 0 0" ZIndex="1">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
        <Button Command="{Binding ResetCommand}" ToolTip.Tip="Untick everything but the sounds of 2 minutes or longer, and remove nothing">
          <TextBlock Text="Reset to suggested" />
        </Button>
        <Button Name="CancelButton" Content="Cancel" />
        <Button Name="SaveButton" Classes="accent" ToolTip.Tip="Keep these picks for the map; porting it applies them">
          <StackPanel>
            <materialIcons:MaterialIcon Kind="ContentSaveOutline" />
            <TextBlock Text="Save" />
          </StackPanel>
        </Button>
      </StackPanel>
      <!--
        How loud the preview plays: a vertical slider that opens over the list on hover or click, like a media player's.
        It's drawn in this window (overflowing the bar upwards) rather than in a Popup, whose separate window made the
        button lose the pointer as it opened, so it flickered open and shut.
      -->
      <Panel Name="VolumeHost" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0 0 8 0">
        <Button Name="VolumeButton" Classes="icon" Width="32" Height="32" Command="{Binding MuteCommand}">
          <Panel>
            <materialIcons:MaterialIcon Kind="VolumeHigh" Width="20" Height="20" IsVisible="{Binding !IsMuted}" />
            <materialIcons:MaterialIcon Kind="VolumeOff" Width="20" Height="20" IsVisible="{Binding IsMuted}" />
          </Panel>
        </Button>
        <!-- A Canvas takes no room, so the slider sits above the button without growing the bar -->
        <Canvas>
          <Border Name="VolumePanel" IsVisible="False" Width="44" Canvas.Left="-6" Canvas.Bottom="32" Padding="0 10 0 8"
                  CornerRadius="6" BorderThickness="1"
                  Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" BorderBrush="{StaticResource PanelBorder}">
            <StackPanel Spacing="6">
              <Slider Name="VolumeSlider" Value="{Binding Volume}" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                      Orientation="Vertical" Height="130" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding VolumeText}" FontSize="12" HorizontalAlignment="Center"
                         FontFamily="{StaticResource Monospace}" />
            </StackPanel>
          </Border>
        </Canvas>
      </Panel>

      <!-- The playing sound's timeline: drag or click it to skip ahead, e.g. past a long fade-in -->
      <Panel Margin="0 0 16 0">
        <Grid ColumnDefinitions="Auto, Auto, *, Auto" VerticalAlignment="Center" IsVisible="{Binding IsPreviewing}">
          <Button Grid.Column="0" Classes="icon" Command="{Binding StopCommand}" ToolTip.Tip="Stop" VerticalAlignment="Center">
            <materialIcons:MaterialIcon Kind="Stop" Width="16" Height="16" />
          </Button>
          <TextBlock Name="NowPlayingText" Grid.Column="1" Text="{Binding NowPlaying}" FontWeight="SemiBold" MaxWidth="170" Margin="4 0 10 0"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding NowPlaying}" />
          <Slider Name="TimelineSlider" Grid.Column="2" Value="{Binding Position}" Minimum="0" Maximum="{Binding Duration}" MinWidth="80"
                  SmallChange="5" LargeChange="15" VerticalAlignment="Center" ToolTip.Tip="Skip to a point in the sound" />
          <TextBlock Grid.Column="3" Text="{Binding PositionText}" Margin="10 0 0 0" VerticalAlignment="Center"
                     FontFamily="{StaticResource Monospace}" FontSize="12" />
        </Grid>
        <TextBlock Text="{Binding PreviewStatus}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding PreviewStatus}" IsVisible="{Binding !IsPreviewing}" />
      </Panel>
    </DockPanel>

    <Border Classes="panel" Padding="10">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Rows}" />
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>

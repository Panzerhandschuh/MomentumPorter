<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MomentumPorter.UI.ViewModels.Pages"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="MomentumPorter.UI.Views.Pages.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">

  <UserControl.Styles>
    <Style Selector="StackPanel.setting">
      <Setter Property="Spacing" Value="4" />
    </Style>
    <Style Selector="StackPanel.setting > TextBlock.label">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="StackPanel.setting > TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="16 14 16 16" Spacing="18" MaxWidth="900" HorizontalAlignment="Left">
      <StackPanel Spacing="2">
        <TextBlock Text="Settings" Classes="h1" />
        <TextBlock Classes="muted" TextWrapping="Wrap">
          <Run Text="Saved automatically to" />
          <Run Text="{Binding SettingsFile}" />
        </TextBlock>
        <TextBlock Text="{Binding SaveError}" Classes="error" TextWrapping="Wrap"
                   IsVisible="{Binding SaveError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>

      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="16">
          <TextBlock Text="Momentum Mod" Classes="h2" />
          <StackPanel Classes="setting">
            <TextBlock Classes="label" Text="Install folder" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Margin="6 0 0 0" Command="{Binding BrowseMomentumCommand}" ToolTip.Tip="Browse">
                <materialIcons:MaterialIcon Kind="FolderOpenOutline" />
              </Button>
              <TextBox Text="{Binding MomentumDirectory, UpdateSourceTrigger=LostFocus}"
                       Watermark="{Binding DetectedMomentum, TargetNullValue='Not found in your Steam libraries', StringFormat='Detected: {0}'}" />
            </DockPanel>
            <TextBlock Classes="hint" Text="{Binding MomentumStatus}" />
            <TextBlock Classes="hint" Text="Leave empty to use the install found in your Steam libraries. Ported maps go into its maps folder and packs into its custom folder." />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="16">
          <TextBlock Text="Kreedz Climbing" Classes="h2" />
          <StackPanel Classes="setting">
            <TextBlock Classes="label" Text="Install folder" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Margin="6 0 0 0" Command="{Binding BrowseKreedzClimbingCommand}" ToolTip.Tip="Browse">
                <materialIcons:MaterialIcon Kind="FolderOpenOutline" />
              </Button>
              <TextBox Text="{Binding KreedzClimbingDirectory, UpdateSourceTrigger=LostFocus}"
                       Watermark="{Binding DetectedKreedzClimbing, TargetNullValue='Not found in your Steam libraries', StringFormat='Detected: {0}'}" />
            </DockPanel>
            <TextBlock Classes="hint" Text="{Binding KreedzClimbingStatus}" />
            <TextBlock Classes="hint" Text="Leave empty to use the install found in your Steam libraries. KZ maps get their textures, models and sounds packed from it, and their soundscapes from its shared soundscape files." />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="16">
          <TextBlock Text="Tools" Classes="h2" />
          <StackPanel Classes="setting">
            <TextBlock Classes="label" Text="studiomdl" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Margin="6 0 0 0" Command="{Binding BrowseStudiomdlCommand}" ToolTip.Tip="Browse">
                <materialIcons:MaterialIcon Kind="FolderOpenOutline" />
              </Button>
              <TextBox Text="{Binding StudiomdlPath, UpdateSourceTrigger=LostFocus}"
                       Watermark="{Binding DefaultStudiomdlPath, TargetNullValue='Path to studiomdl.exe', StringFormat='Default: {0}'}" />
            </DockPanel>
            <TextBlock Classes="hint" Text="{Binding StudiomdlStatus}" />
            <TextBlock Classes="hint"
                       Text="Compiles the models GoldSrc maps and converted weapons use. Leave empty for Momentum's own studiomdl." />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="16">
          <TextBlock Text="Folders" Classes="h2" />
          <StackPanel Classes="setting">
            <TextBlock Classes="label" Text="Output folder" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Margin="6 0 0 0" Command="{Binding BrowseOutputDirectoryCommand}" ToolTip.Tip="Browse">
                <materialIcons:MaterialIcon Kind="FolderOpenOutline" />
              </Button>
              <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=LostFocus}" Watermark="{Binding DefaultOutputDirectory, StringFormat='Default: {0}'}" />
            </DockPanel>
            <TextBlock Classes="hint" Text="Used when Momentum Mod isn't found: weapon packs are written into its custom folder." />
          </StackPanel>
          <StackPanel Classes="setting">
            <TextBlock Classes="label" Text="Work folder" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Margin="6 0 0 0" Command="{Binding BrowseWorkDirectoryCommand}" ToolTip.Tip="Browse">
                <materialIcons:MaterialIcon Kind="FolderOpenOutline" />
              </Button>
              <TextBox Text="{Binding WorkDirectory, UpdateSourceTrigger=LostFocus}" Watermark="{Binding DefaultWorkDirectory, StringFormat='Default: {0}'}" />
            </DockPanel>
            <TextBlock Classes="hint" Text="Maps are ported and packed here, and only moved to Momentum or the output folder once everything succeeded." />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="16">
          <TextBlock Text="Updates" Classes="h2" />
          <StackPanel Classes="setting">
            <CheckBox IsChecked="{Binding CheckForUpdates}" Content="Check for updates when the porter starts" />
            <TextBlock Classes="hint" Text="{Binding VersionText}" />
            <TextBlock Classes="hint" Text="When a new release is out on GitHub, the porter asks whether to download it, then installs it and restarts." />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="10">
          <DockPanel>
            <Button DockPanel.Dock="Right" Command="{Binding RescanCommand}" ToolTip.Tip="Look for the games again">
              <StackPanel>
                <materialIcons:MaterialIcon Kind="Refresh" />
                <TextBlock Text="Rescan" />
              </StackPanel>
            </Button>
            <TextBlock Text="Games" Classes="h2" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="Set a game's folder when your Steam libraries don't have it, or have a different copy. Weapons and player sounds are ported from it, and GoldSrc maps take their WADs from Half-Life's and Counter-Strike 1.6's. Leave empty to use the one detected." />
          <TextBlock Text="Looking for games..." Classes="muted" IsVisible="{Binding IsScanning}" />
          <ItemsControl ItemsSource="{Binding Games}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:DetectedGameViewModel">
                <Grid ColumnDefinitions="24, 240, *" RowDefinitions="Auto, Auto" Margin="0 3">
                  <materialIcons:MaterialIcon Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left"
                                              Kind="CheckCircle" Foreground="{StaticResource SuccessBrush}"
                                              IsVisible="{Binding Found}" />
                  <materialIcons:MaterialIcon Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left"
                                              Kind="MinusCircleOutline" Foreground="{StaticResource MutedBrush}"
                                              IsVisible="{Binding !Found}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                  <SelectableTextBlock Grid.Column="2" Text="{Binding PathText}" Classes.muted="{Binding !Found}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       IsVisible="{Binding !CanSetFolder}" />
                  <DockPanel Grid.Column="2" IsVisible="{Binding CanSetFolder}">
                    <Button DockPanel.Dock="Right" Margin="6 0 0 0" Command="{Binding BrowseCommand}" ToolTip.Tip="Browse">
                      <materialIcons:MaterialIcon Kind="FolderOpenOutline" />
                    </Button>
                    <TextBox Text="{Binding Folder, UpdateSourceTrigger=LostFocus}" Watermark="{Binding Watermark}" />
                  </DockPanel>
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding FolderStatus}" Classes="error" FontSize="12"
                             TextWrapping="Wrap" Margin="0 2 0 0"
                             IsVisible="{Binding FolderStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>

</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MomentumPorter.UI.ViewModels.Pages"
             xmlns:vpk="using:MomentumPorter.Assets.Vpk"
             xmlns:weapons="using:MomentumPorter.Assets.Weapons"
             xmlns:shared="using:MomentumPorter.UI.ViewModels.Shared"
             xmlns:views="using:MomentumPorter.UI.Views.Shared"
             xmlns:conv="using:MomentumPorter.UI.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="MomentumPorter.UI.Views.Pages.PlayerSoundsPageView"
             x:DataType="vm:PlayerSoundsPageViewModel"
             Name="Page">

  <Grid RowDefinitions="Auto, *, 6, 240" ColumnDefinitions="340, 12, *" Margin="16 14 16 12">

    <!-- Header and actions -->
    <!-- The buttons dock first so they keep their width; the description takes what's left and trims -->
    <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0 0 0 12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12 0 0 0">
        <Button Command="{Binding RescanCommand}" ToolTip.Tip="Look for the game again (after installing it)">
          <StackPanel>
            <materialIcons:MaterialIcon Kind="Refresh" />
            <TextBlock Text="Rescan" />
          </StackPanel>
        </Button>
        <Button Command="{Binding BuildCommand}" Classes="accent" ToolTip.Tip="Build the pack and put it in Momentum's custom folder">
          <StackPanel>
            <materialIcons:MaterialIcon Kind="Play" />
            <TextBlock Text="Build pack" />
          </StackPanel>
        </Button>
        <Button Command="{Binding CancelCommand}" ToolTip.Tip="Stop the running build">
          <StackPanel>
            <materialIcons:MaterialIcon Kind="Stop" />
            <TextBlock Text="Cancel" />
          </StackPanel>
        </Button>
      </StackPanel>
      <StackPanel Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="Player Sounds" Classes="h1" />
        <TextBlock Text="Give the player another game's jump, landing and footstep sounds with a pack in Momentum's custom folder"
                   Classes="muted" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DockPanel>

    <!-- Game mode, game, character and the preview; everything else is fixed (PlayerSoundPackOptions.ApplyGameAccurate) -->
    <Border Grid.Row="1" Grid.Column="0" Classes="panel">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Sounds" Classes="h2" Margin="12 8 12 4" />
        <StackPanel DockPanel.Dock="Top" Margin="12 4 12 8" Spacing="4">
          <TextBlock Text="Game mode" FontWeight="SemiBold" />
          <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" HorizontalAlignment="Stretch"
                    ToolTip.Tip="Every mode replaces Momentum's sounds everywhere. One mode's pack is only used in that mode (scripts/&lt;mode&gt;/) and wins over an every-mode pack there">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="weapons:GameModeGroup">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="Game" FontWeight="SemiBold" Margin="0 4 0 0" />
          <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="vpk:SourceGameInfo">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <StackPanel Spacing="4" Margin="0 4 0 0" IsVisible="{Binding !!Characters.Count}">
            <TextBlock Text="{Binding CharacterLabel}" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}" HorizontalAlignment="Stretch" />
          </StackPanel>
          <TextBlock Text="{Binding SourceDescription}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                     IsVisible="{Binding SourceDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <ScrollViewer Padding="12 0 12 4">
          <StackPanel Spacing="4">
            <!-- What the pack would play, one button per sound; each click plays the next of its files -->
            <TextBlock Text="Preview" Classes="h3" Margin="0 0 0 2" />
            <TextBlock Text="{Binding PreviewStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                       IsVisible="{Binding PreviewStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ItemsControl ItemsSource="{Binding PreviewSounds}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:PreviewSoundViewModel">
                  <Grid ColumnDefinitions="Auto, *">
                    <Button Grid.Column="0" Classes="icon" Command="{Binding PlayCommand}" VerticalAlignment="Top" Margin="0 0 8 0">
                      <materialIcons:MaterialIcon Kind="PlayCircleOutline" Width="22" Height="22" />
                    </Button>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                                 IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <TextBlock Text="{Binding Label}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" Classes.error="{Binding IsError}"
                                 Classes.muted="{Binding !IsError}"
                                 IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Builds -->
    <Border Grid.Row="1" Grid.Column="2" Classes="panel">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Builds" Classes="h2" Margin="12 8 12 4" />
        <Panel>
          <StackPanel IsVisible="{Binding !Builds.Count}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="420">
            <materialIcons:MaterialIcon Kind="VolumeHigh" Width="40" Height="40" Opacity="0.5" />
            <TextBlock Text="Pick a game mode and a game, then Build pack. Momentum's jump, landing, footstep and sprint sounds become the game's on every surface, and the ones it has nothing like are muted. The pack goes to momentum/custom; delete it to get Momentum's sounds back. Each mode uses one player sound pack: its own if it has one, else the every-mode pack."
                       Classes="muted" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>
          <ListBox ItemsSource="{Binding Builds}" SelectedItem="{Binding SelectedBuild}" Background="Transparent"
                   IsVisible="{Binding !!Builds.Count}">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="10 8" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Margin" Value="4 1" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:SoundPackBuildViewModel">
                <Grid ColumnDefinitions="Auto, *">
                  <materialIcons:MaterialIcon Grid.Column="0" Width="20" Height="20" VerticalAlignment="Top" Margin="0 1 10 0"
                                              Kind="{Binding Status, Converter={x:Static conv:QueueStatusConverters.Icon}}"
                                              Foreground="{Binding Status, Converter={x:Static conv:QueueStatusConverters.Brush}}"
                                              ToolTip.Tip="{Binding Status}" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <StackPanel IsVisible="{Binding IsRunning}" Spacing="2" Margin="0 4 0 0">
                      <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" MinWidth="0" Height="4" />
                      <TextBlock Text="{Binding StepText}" FontSize="12" Classes="muted" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{Binding Status, Converter={x:Static conv:QueueStatusConverters.Brush}}"
                               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding OutputPath}" FontSize="12" Classes="muted" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding OutputPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Panel>
      </DockPanel>
    </Border>

    <GridSplitter Grid.Row="2" Grid.ColumnSpan="3" ResizeDirection="Rows" Background="Transparent" />

    <!-- Log and report of the selected build -->
    <Border Grid.Row="3" Grid.ColumnSpan="3" Classes="panel">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="6 4 6 0">
          <Button DockPanel.Dock="Right" Command="{Binding OpenPackFolderCommand}" ToolTip.Tip="Show the pack, or Momentum's custom folder">
            <StackPanel>
              <materialIcons:MaterialIcon Kind="FolderOutline" />
              <TextBlock Text="Open pack folder" />
            </StackPanel>
          </Button>
          <TextBlock Text="{Binding SelectedBuild.Title, FallbackValue='', TargetNullValue=''}" Classes="muted"
                     VerticalAlignment="Center" Margin="8 0" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <TabControl Padding="0" Margin="4 0 4 4">
          <TabItem Header="Log" FontSize="14">
            <views:LogView DataContext="{Binding SelectedBuild.Log, FallbackValue={x:Null}}" />
          </TabItem>
          <TabItem Header="Report" FontSize="14">
            <ScrollViewer Background="#33000000">
              <StackPanel Margin="10 6">
                <TextBlock Text="Nothing to report yet. The report lists what the pack replaced and anything to know about it."
                           Classes="muted" TextWrapping="Wrap"
                           IsVisible="{Binding !SelectedBuild.HasReport, FallbackValue=True}" />
                <ItemsControl ItemsSource="{Binding SelectedBuild.Report, FallbackValue={x:Null}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="shared:ReportLine">
                      <SelectableTextBlock Text="{Binding Text}" FontFamily="{StaticResource Monospace}" FontSize="12"
                                           Classes.warning="{Binding IsWarning}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </DockPanel>
    </Border>
  </Grid>

</UserControl>

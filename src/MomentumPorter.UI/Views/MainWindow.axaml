<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MomentumPorter.UI.ViewModels"
        xmlns:pages="using:MomentumPorter.UI.ViewModels.Pages"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="MomentumPorter.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1200" Height="760" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

  <Grid ColumnDefinitions="200, *" RowDefinitions="*, Auto">

    <!-- Navigation -->
    <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Background="#0DFFFFFF"
            BorderBrush="{StaticResource PanelBorder}" BorderThickness="0 0 1 0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16 18 16 14" Spacing="2">
          <TextBlock Text="Momentum Porter" FontSize="17" FontWeight="Bold" />
          <TextBlock Text="Port maps and assets to Momentum Mod" Classes="muted" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" Background="Transparent"
                 Margin="6 0">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="CornerRadius" Value="4" />
              <Setter Property="Padding" Value="10 8" />
              <Setter Property="Margin" Value="0 1" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="pages:PageViewModel">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <materialIcons:MaterialIcon Kind="{Binding Icon}" Width="18" Height="18" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Page -->
    <ContentControl Grid.Column="1" Grid.Row="0" Content="{Binding SelectedPage}" />

    <!-- Status bar -->
    <Border Grid.Column="1" Grid.Row="1" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0 1 0 0"
            Padding="12 5" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="icon" Click="DismissStatus_OnClick" ToolTip.Tip="Dismiss">
          <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" />
        </Button>
        <materialIcons:MaterialIcon Kind="InformationOutline" Width="16" Height="16" Margin="0 0 8 0" />
        <SelectableTextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <!-- Drop overlay -->
    <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False"
            IsVisible="{Binding IsDragOver}" Background="#EE101418">
      <Border BorderBrush="#66FFFFFF" BorderThickness="2" CornerRadius="12" Margin="24">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
          <materialIcons:MaterialIcon Kind="TrayArrowDown" Width="56" Height="56" />
          <TextBlock Text="Drop to add to Momentum Porter" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="Maps (.bsp, .pk3, .zip) go to the Maps queue" Classes="muted" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>

</Window>

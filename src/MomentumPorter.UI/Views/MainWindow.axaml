<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MomentumPorter.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="MomentumPorter.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1100" Height="700" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <!-- Phase 1 replaces this with the navigation shell (Maps / Weapons / Player Sounds / Player Models / Settings) -->
  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
    <TextBlock Text="MomentumPorter" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
    <TextBlock Text="{Binding Status}" HorizontalAlignment="Center" Opacity="0.7" />
  </StackPanel>

</Window>

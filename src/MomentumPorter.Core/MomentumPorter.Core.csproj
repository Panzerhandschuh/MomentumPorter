<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MomentumPorter</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- LibBSP's own dependency, for compressed lumps and the pakfile. Keep in step with BSPConvert.Lib's version. -->
    <PackageReference Include="SharpCompress" Version="0.39.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- LibBSP (github.com/Panzerhandschuh/LibBSP) is expected to be checked out and built (Release) next to this repo.
         See Directory.Build.props for how to point at another location. -->
    <Reference Include="libBSP">
      <HintPath>$(LibBspDll)</HintPath>
    </Reference>
    <ProjectReference Include="$(BspConvertDir)BSPConvert.Lib\BSPConvert.Lib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Quake 3 and GoldSrc map conversion (github.com/Panzerhandschuh/BSPConvert), checked out next to this repo.
         It brings its sourcepp native dlls, Assets, Q3Content and CustomContent folders into the output of every
         project referencing Core.
         BSPConvert.Lib references its own copy of libBSP (Dependencies\libBSP.dll, same assembly identity). The
         Reference above is a primary reference, which wins over that dependency here and in the projects referencing
         Core, so the output always has $(LibBspDll) and BSPConvert runs on it too. BSPConvert's copy only lands, unused,
         in the output's Dependencies folder. -->
    <ProjectReference Include="$(BspConvertDir)BSPConvert.Lib\BSPConvert.Lib.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MomentumPorter</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- LibBSP's own dependency, for compressed lumps and the pakfile. Keep in step with BSPConvert.Lib's version. -->
    <PackageReference Include="SharpCompress" Version="0.39.0" />
    <!-- Reads the VPKs of the games Momentum mounts (weapon packs check the paths they reference exist) -->
    <PackageReference Include="ValvePak" Version="6.0.0.182" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Weapons\weapons.json" LogicalName="MomentumPorter.Assets.Weapons.weapons.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Quake 3 and GoldSrc map conversion (github.com/momentum-mod/BSPConvert), the external/BSPConvert submodule
         unless Directory.Build.local.props sets BspConvertDir. It brings its sourcepp native dlls, Assets, Q3Content and
         CustomContent folders into the output of every project referencing Core. -->
    <ProjectReference Include="$(BspConvertDir)BSPConvert.Lib\BSPConvert.Lib.csproj" />
    <!-- BSPConvert.Lib's VTF writer, used directly for Quake 3 weapon textures (assembly references don't flow) -->
    <Reference Include="sourcepp">
      <HintPath>$(BspConvertDir)BSPConvert.Lib\Dependencies\sourcepp.dll</HintPath>
    </Reference>
    <!-- LibBSP (github.com/Panzerhandschuh/LibBSP's fork, for LZMA): BSPConvert's own copy by default (see
         Directory.Build.props). It has the same assembly identity as the copy BSPConvert.Lib references, and this
         primary reference wins over that dependency here and in the projects referencing Core, so the output always has
         $(LibBspDll) and BSPConvert runs on it too. -->
    <Reference Include="libBSP">
      <HintPath>$(LibBspDll)</HintPath>
    </Reference>
  </ItemGroup>

</Project>

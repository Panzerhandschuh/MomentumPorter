<Project>

  <PropertyGroup>
    <!-- BSPConvert.Lib targets net10.0, so everything that references it has to as well -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <!-- BSPConvert is the external/BSPConvert submodule. To work on BSPConvert or LibBSP alongside the porter, point
         BspConvertDir / LibBspDir at your own checkouts in Directory.Build.local.props (git ignored). -->
    <BspConvertDir>$(RepoRoot)external\BSPConvert\</BspConvertDir>
    <!-- 0.0.0 marks a development build, which doesn't check for updates. tools/publish-release.ps1 -Version sets the
         release's version, which the updater compares with the latest GitHub release's tag. -->
    <VersionPrefix>0.0.0</VersionPrefix>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />

  <PropertyGroup>
    <!-- A LibBSP checkout's Release build if one is set, otherwise the libBSP build BSPConvert ships with -->
    <LibBspDll Condition="'$(LibBspDll)' == '' and '$(LibBspDir)' != ''">$(LibBspDir)LibBSP\bin\Release\libBSP.dll</LibBspDll>
    <LibBspDll Condition="'$(LibBspDll)' == ''">$(BspConvertDir)BSPConvert.Lib\Dependencies\libBSP.dll</LibBspDll>
  </PropertyGroup>

</Project>
